DB_ROOT_PASSWORD=change_me
DB_NAME=restaurant_app
JWT_SECRET=change_me_to_a_long_random_string

# Email verification (Gmail: enable 2-Step Verification and create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_SECURE=false
SMTP_FROM=your-gmail-address@gmail.com

# Optional: first manager created via `docker compose run --rm backend npm run bootstrap-manager`
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_ID=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PHONE=
BOOTSTRAP_MANAGER_PASSWORD=