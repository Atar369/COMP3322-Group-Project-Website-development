DB_ROOT_PASSWORD=change_me
DB_NAME=restaurant_app
JWT_SECRET=change_me_to_a_long_random_string

# Verification links should point to the app that created the account.
# Use http://localhost for local Docker; this default is the deployed server.
FRONTEND_URL=http://c3322-pg04.cs.hku.hk

# Coursework demo: leave SMTP blank to use an Ethereal preview link (no inbox delivery).
# Real inbox delivery requires SMTP credentials configured privately, never in Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# Optional: first manager created via `docker compose run --rm backend npm run bootstrap-manager`
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_ID=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PHONE=
BOOTSTRAP_MANAGER_PASSWORD=