# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=restaurant_app

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Menu images
MENU_IMAGE_DIR=./public/uploads/menu-images

# SMTP (leave blank in dev to auto-use Ethereal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@emberandoak.local

# First Manager Bootstrap Variables
BOOTSTRAP_MANAGER_NAME=Head Manager
BOOTSTRAP_MANAGER_ID=MGR001
BOOTSTRAP_MANAGER_EMAIL=manager@example.com
BOOTSTRAP_MANAGER_PHONE=98765432
BOOTSTRAP_MANAGER_PASSWORD=your_strong_password_here